<odoo>
    <data>

        <record id="view_partner_form_nominee_info" model="ir.ui.view">
            <field name="name">res.partner.form.nominee.info</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- core Person/Company radio HIDE -->
                <xpath expr="//field[@name='company_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- same jaga par 3-option radio show (Person / Company / Customer) -->
                <xpath expr="//field[@name='company_type']" position="after">
                    <field name="customer_type" widget="radio"/>
                </xpath>

                <!-- Right-side group replace: Job Position + NTN + (Customer block) + Website + Tags -->
                <xpath expr="//group[field[@name='function'] and field[@name='vat']]" position="replace">
                    <!-- Default Odoo fields -->
                    <group>
                        <field name="function" placeholder="e.g. Sales Director"/>
                        <field name="vat" string="NTN"/>
                        <field name="website" string="Website Link"/>
                        <field name="category_id" widget="many2many_tags" string="Tags"/>
                    </group>

                    <!-- Customer-only block -->
                    <group invisible="customer_type != 'customer'">
                        <field name="member_id" string="Member ID" readonly="1"/>

                        <field name="relation"
                               required="customer_type == 'customer'"/>

                        <span class="o_form_label">
                            <field name="relation_label" readonly="1" nolabel="1"/>
                        </span>

                        <field name="relative_name"
                               nolabel="1"
                               placeholder="Enter Name"
                               required="customer_type == 'customer'"/>

                        <field name="cnic"
                               string="CNIC"
                               placeholder="35202-1234567-1"
                               pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"
                               required="customer_type == 'customer'"/>

                        <field name="mobile"
                               placeholder="xxxx-xxxxxxx"
                               required="customer_type == 'customer'"/>
                    </group>
                </xpath>

                <!-- Address placeholders (left side) -->
                <xpath expr="//field[@name='street']" position="attributes">
                    <attribute name="placeholder">Mailing Address (Current)</attribute>
                </xpath>
                <xpath expr="//field[@name='street2']" position="attributes">
                    <attribute name="placeholder">Mailing Address (Permanent)</attribute>
                </xpath>

                <!-- Nominee tab – only when Customer selected -->
                <xpath expr="//notebook" position="inside">
                    <page string="Nominee Information"
                          invisible="customer_type != 'customer'">
                        <group>

                            <!-- Nominee 1 (all required for customer) -->
                            <group string="Nominee 1">
                                <field name="nominee_name"
                                       required="customer_type == 'customer'"/>
                                <field name="relation_1"
                                       required="customer_type == 'customer'"/>
                                <span class="o_form_label">
                                    <field name="relation_label_1" readonly="1" nolabel="1"/>
                                </span>
                                <field name="relative_name_1"
                                       nolabel="1"
                                       placeholder="Enter Name"
                                       required="customer_type == 'customer'"/>
                                <field name="nominee_cnic"
                                       placeholder="35202-1234567-1"
                                       pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"
                                       required="customer_type == 'customer'"/>
                                <field name="application"
                                       required="customer_type == 'customer'"/>
                            </group>

                            <!-- Nominee 2–5 optional -->
                            <group string="Nominee 2">
                                <field name="nominee_name_2"/>
                                <field name="relation_2"/>
                                <span class="o_form_label">
                                    <field name="relation_label_2" readonly="1" nolabel="1"/>
                                </span>
                                <field name="relative_name_2" nolabel="1" placeholder="Enter Name"/>
                                <field name="nominee_cnic_2"
                                       placeholder="35202-1234567-1"
                                       pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"/>
                                <field name="application_2"/>
                            </group>

                            <group string="Nominee 3">
                                <field name="nominee_name_3"/>
                                <field name="relation_3"/>
                                <span class="o_form_label">
                                    <field name="relation_label_3" readonly="1" nolabel="1"/>
                                </span>
                                <field name="relative_name_3" nolabel="1" placeholder="Enter Name"/>
                                <field name="nominee_cnic_3"
                                       placeholder="35202-1234567-1"
                                       pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"/>
                                <field name="application_3"/>
                            </group>

                            <group string="Nominee 4">
                                <field name="nominee_name_4"/>
                                <field name="relation_4"/>
                                <span class="o_form_label">
                                    <field name="relation_label_4" readonly="1" nolabel="1"/>
                                </span>
                                <field name="relative_name_4" nolabel="1" placeholder="Enter Name"/>
                                <field name="nominee_cnic_4"
                                       placeholder="35202-1234567-1"
                                       pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"/>
                                <field name="application_4"/>
                            </group>

                            <group string="Nominee 5">
                                <field name="nominee_name_5"/>
                                <field name="relation_5"/>
                                <span class="o_form_label">
                                    <field name="relation_label_5" readonly="1" nolabel="1"/>
                                </span>
                                <field name="relative_name_5" nolabel="1" placeholder="Enter Name"/>
                                <field name="nominee_cnic_5"
                                       placeholder="35202-1234567-1"
                                       pattern="^[0-9]{5}-[0-9]{7}-[0-9]{1}$"/>
                                <field name="application_5"/>
                            </group>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
