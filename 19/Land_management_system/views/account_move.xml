<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- FORM VIEW -->
    <record id="view_move_form_payment_plan" model="ir.ui.view">
        <field name="name">account.move.form.payment.plan.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add fields after invoice_date -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <!-- Payment plan stage -->
                <field name="payment_plan_stage"/>

                <!-- Percentage of SO total for this invoice -->
                <field name="payment_plan_percentage" readonly="1"/>

                <!-- Related Sale Order -->
                <field name="sale_id" readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_move_tree_payment_plan" model="ir.ui.view">
        <field name="name">account.move.tree.payment.plan.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">

            <!-- Add columns after name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="payment_plan_stage"/>
                <field name="payment_plan_percentage"/>
            </xpath>

        </field>
    </record>

</odoo>
