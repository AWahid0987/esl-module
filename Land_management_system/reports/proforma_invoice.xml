<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat for Proforma Invoice -->
    <record id="paperformat_proforma_invoice" model="report.paperformat">
        <field name="name">Proforma Invoice</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="orientation">Portrait</field>
        <field name="header_line" eval="False"/>
    </record>

    <!-- Proforma Invoice Report -->
    <record id="action_report_proforma_invoice" model="ir.actions.report">
        <field name="name">Proforma Invoice</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">Land_management_system.report_proforma_invoice</field>
        <field name="report_file">Land_management_system.report_proforma_invoice</field>
        <field name="print_report_name">'Proforma Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_proforma_invoice"/>
    </record>

    <!-- Proforma Invoice Template -->

    <template id="report_proforma_invoice">
        <t t-name="Land_management_system.report_proforma_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header Section -->
                        <div class="header-section" style="background-color: #1e3a5f; padding: 20px; color: white; display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center;">
                                <img t-att-src="'/Land_management_system/static/src/img/logo_left.webp'" 
                                     style="height: 60px; max-width: 180px; object-fit: contain;"/>
                            </div>
                            <div style="text-align: center; flex: 1;">
                                <img t-att-src="'/Land_management_system/static/src/img/logo_center.webp'" 
                                     style="height: 70px; max-width: 220px; object-fit: contain; margin: 0 auto;"/>
                            </div>
                            <div style="text-align: right; display: flex; align-items: center; justify-content: flex-end;">
                                <img t-att-src="'/Land_management_system/static/src/img/logo_right.webp'" 
                                     style="height: 60px; max-width: 180px; object-fit: contain;"/>
                            </div>
                        </div>
                        <div style="text-align: center; background-color: #1e3a5f; padding: 15px;">
                            <h1 style="color: white; margin: 0; font-size: 28px; font-weight: bold;">PROFORMA INVOICE</h1>
                        </div>

                        <!-- Invoice Details Section -->
                        <div style="padding: 20px; background-color: white;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                                <div style="flex: 1;">
                                    <div style="margin-bottom: 10px;">
                                        <strong>Project:</strong>
                                    </div>
                                    <div style="margin-bottom: 10px;">
                                        <strong>Unit No.:</strong> <span t-field="o.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                    <div style="margin-bottom: 10px;">
                                        <strong>PI No.:</strong> <span t-field="o.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                                <div style="flex: 1;">
                                    <div style="margin-bottom: 10px;">
                                        <strong>Invoice Date:</strong> <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                                    </div>
                                    <div style="margin-bottom: 10px;">
                                        <strong>Currency:</strong> <span t-field="o.currency_id.name" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Billing Information -->
                            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                                <div style="flex: 1; border: 1px solid #d4a574; padding: 15px;">
                                    <div style="font-weight: bold; margin-bottom: 10px;">Bill To:</div>
                                    <div style="min-height: 80px; margin-bottom: 10px;">
                                        <div t-field="o.partner_id.name" t-options="{'widget': 'text'}"/>
                                        <div t-field="o.partner_id.street" t-options="{'widget': 'text'}"/>
                                        <div t-field="o.partner_id.city" t-options="{'widget': 'text'}"/>
                                    </div>
                                    <div>
                                        <strong>TRN:</strong> <span t-field="o.partner_id.vat" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                                <div style="flex: 1; border: 1px solid #d4a574; padding: 15px;">
                                    <div style="font-weight: bold; margin-bottom: 10px;">Bill From:</div>
                                    <div style="min-height: 80px; margin-bottom: 10px;">
                                        <div t-field="o.company_id.name" t-options="{'widget': 'text'}"/>
                                        <div t-field="o.company_id.street" t-options="{'widget': 'text'}"/>
                                        <div t-field="o.company_id.city" t-options="{'widget': 'text'}"/>
                                    </div>
                                    <div>
                                        <strong>TRN:</strong> <span t-field="o.company_id.vat" t-options="{'widget': 'text'}"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Itemized Table -->
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                                <thead>
                                    <tr style="background-color: #1e3a5f; color: white;">
                                        <th style="padding: 12px; text-align: left; border: 1px solid #ddd;">Sr.No.</th>
                                        <th style="padding: 12px; text-align: left; border: 1px solid #ddd;">Description</th>
                                        <th style="padding: 12px; text-align: right; border: 1px solid #ddd;">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="numbered_lines" t-value="o._get_numbered_order_lines()"/>
                                    <tr t-foreach="numbered_lines" t-as="line_data" style="border-bottom: 1px solid #ddd;">
                                        <td style="padding: 10px; border: 1px solid #ddd;" t-esc="line_data['sr_no']"/>
                                        <t t-set="line" t-value="line_data['line']"/>
                                        <td style="padding: 10px; border: 1px solid #ddd;">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                        <td style="padding: 10px; text-align: right; border: 1px solid #ddd;">
                                            <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Total Amount -->
                            <div style="margin-bottom: 20px;">
                                <div style="margin-bottom: 10px;">
                                    <strong>Total Amount:</strong>
                                    <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                                <div>
                                    <strong>Amount in Words:</strong>
                                    <span t-esc="o._get_amount_in_words(o.amount_total, o.currency_id.name)"/>
                                </div>
                            </div>

                            <!-- Escrow Account Details -->
                            <div style="margin-top: 30px;">
                                <h3 style="font-weight: bold; margin-bottom: 15px;">Escrow Account Details:</h3>
                                <table style="width: 100%; border-collapse: collapse;">
                                    <tr>
                                        <td style="padding: 5px; width: 200px;"><strong>Name of Bank:</strong></td>
                                        <td style="padding: 5px;">National Bank of Fujairah PJSC</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>Account Number:</strong></td>
                                        <td style="padding: 5px;">012302244268</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>IBAN No.:</strong></td>
                                        <td style="padding: 5px;">AE480380000012302244268</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>Account Name:</strong></td>
                                        <td style="padding: 5px;">ELMORA</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>AC Currency:</strong></td>
                                        <td style="padding: 5px;">AED</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>Branch Name/Address:</strong></td>
                                        <td style="padding: 5px;">P.O. Box 2979, Dubai, U.A.E</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 5px;"><strong>Swift Code:</strong></td>
                                        <td style="padding: 5px;">NBFUAEAFDXB</td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div style="text-align: center; margin-top: 40px; padding: 20px;">
                            <div style="font-weight: bold; margin-bottom: 5px;">Neoterra Real Estate Development LLC</div>
                            <div>Office 303 &amp; 304, Building 12, Bay Square, Business Bay, Dubai</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
        </t>
    </template>


</odoo>