<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Report Action 1: Category Payment Plan Report -->
    <record id="action_category_payment_plan_report_1" model="ir.actions.report">
        <field name="name">Navy Report 1</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">land_plot_manager.category_payment_plan_report_1_template</field>
        <field name="report_file">land_plot_manager.category_payment_plan_report_1_template</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Category_Payment_Plan_Report_1_' + (object.name or str(object.id) or 'Draft')</field>
    </record>

    <!-- Paperformat -->
    <record id="paperformat_category_payment_plan_1" model="report.paperformat">
        <field name="name">Category Payment Plan Format 1</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="report_ids" eval="[(4, ref('land_plot_manager.action_category_payment_plan_report_1'))]"/>
    </record>

    <!-- Report Template -->
    <template id="category_payment_plan_report_1_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .confidential-watermark {
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%) rotate(-45deg);
                        font-size: 80px;
                        color: rgba(0, 0, 0, 0.1);
                        font-weight: bold;
                        z-index: -1;
                        pointer-events: none;
                    }
                    .header-table {
                        width: 100%;
                        border-collapse: none;
                        border: 0px solid #fff;
                        margin-bottom: 30px;
                    }
                    .payment-plan-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin: 20px 0;
                    }
                    .payment-plan-table th,
                    .payment-plan-table td {
                        border: 1px solid #000;
                        padding: 12px;
                        text-align: left;
                    }
                    .payment-plan-table th {
                        background-color: #f0f0f0;
                        font-weight: bold;
                        text-align: center;
                    }
                    .payment-plan-table td {
                        text-align: right;
                    }
                    .payment-plan-table td:first-child {
                        text-align: left;
                        font-weight: bold;
                    }
                    .terms-section {
                        margin-top: 30px;
                        padding-top: 20px;
                        border-top: 2px solid #000;
                    }
                    .terms-section ul {
                        margin-left: 20px;
                    }
                    .terms-section li {
                        margin-bottom: 8px;
                    }
                </style>

                <main class="page" style="padding: 40px; font-family: Arial, sans-serif; color: #000; position: relative;">
                    <div class="confidential-watermark">CONFIDENTIAL</div>

                    <!-- Header with Logos -->
                    <table class="header-table">
                        <tr>
                            <!-- Left Logo -->
                            <td style="width:25%; border:none; text-align:left; vertical-align:middle;">
                                <img src="/land_plot_manager/static/src/img/leftlogo.png"
                                     style="width: 100%; max-width: 150px; height: auto;"/>
                            </td>

                            <!-- Center Text -->
                            <td style="width:50%; border:none; text-align:center; vertical-align:middle;">
                                <h1 style="margin:0; font-size:22px; font-weight:bold;">A &amp; A ASSOCIATES-LAND PROVIDER FOR</h1>
                                <h1 style="margin:5px 0; font-size:22px; font-weight:bold;">ANCHORAGE LAHORE</h1>
                                <h2 style="margin:10px 0; font-size:18px; font-weight:bold;">RESIDENTIAL PLOT PAYMENT PLANS</h2>
                            </td>

                            <!-- Right Logo -->
                            <td style="width:25%; border:none; text-align:right; vertical-align:middle;">
                                <img src="/land_plot_manager/static/src/img/rightlogo.png"
                                     style="width: 100%; max-width: 250px; height: auto;"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Payment Plans Data - Based on Sale Order -->
                    <t t-set="plan_data" t-value="docs[0].get_payment_plan_data()"/>
                    <t t-set="sale_order" t-value="docs[0].sale_id"/>
                    <t t-if="not sale_order">
                        <t t-foreach="docs[0].invoice_line_ids" t-as="line">
                            <t t-if="line.sale_line_ids and not sale_order">
                                <t t-set="sale_order" t-value="line.sale_line_ids[0].order_id"/>
                            </t>
                        </t>
                    </t>

                    <!-- Get Category Name -->
                    <t t-set="category_name" t-value="''"/>
                    <t t-if="sale_order">
                        <t t-foreach="sale_order.order_line" t-as="so_line">
                            <t t-if="so_line.product_id and so_line.product_id.categ_id and not category_name">
                                <t t-set="category_name" t-value="so_line.product_id.categ_id.name"/>
                            </t>
                        </t>
                    </t>

                    <!-- Display Payment Plan for this Sale Order's Category -->
                    <t t-foreach="plan_data.items()" t-as="plan_item">
                        <t t-set="cat_name" t-value="plan_item[0]"/>
                        <t t-set="plan_info" t-value="plan_item[1]"/>
                        
                        <h3 style="font-size: 16px; font-weight: bold; margin-top: 30px; margin-bottom: 10px;">
                            <t t-esc="cat_name"/> Payment Plan:
                        </h3>
                        
                        <t t-if="sale_order">
                            <p style="margin-bottom: 10px;">
                                <strong>Sale Order:</strong> <t t-esc="sale_order.name"/>
                                <t t-if="sale_order.partner_id"> | <strong>Customer:</strong> <t t-esc="sale_order.partner_id.name"/></t>
                            </p>
                        </t>
                        
                        <table class="payment-plan-table">
                            <thead>
                                <tr>
                                    <th>Total Price</th>
                                    <th>Down Payment</th>
                                    <th>Balance</th>
                                    <th>Tenure</th>
                                    <th>Monthly Installment</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><t t-esc="'{:,.0f}'.format(plan_info.get('total_price', 0))"/></td>
                                    <td><t t-esc="'{:,.0f}'.format(plan_info.get('down_payment', 0))"/></td>
                                    <td><t t-esc="'{:,.0f}'.format(plan_info.get('balance', 0))"/></td>
                                    <td><t t-esc="str(plan_info.get('tenure', 60)) + ' months'"/></td>
                                    <td><t t-esc="'{:,.0f}'.format(plan_info.get('monthly_installment', 0))"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- Terms and Conditions -->
                    <div class="terms-section">
                        <h3 style="font-size: 16px; font-weight: bold; margin-bottom: 15px;">Terms and Conditions:</h3>
                        <ul>
                            <li>Prices can change without prior notice. These Prices are exclusively for Navy Officers.</li>
                            <li>First installment is due 30 days after down payment.</li>
                            <li>Ten percent premium applies on corner plots.</li>
                            <li>Ten percent premium applies on park-facing plots.</li>
                            <li>Fifteen percent premium applies if both factors apply.</li>
                            <li>Cost of land only; development charges apply separately.</li>
                            <li>File processing fee applies separately.</li>
                            <li>Ten percent discount applies on lump sum payment.</li>
                        </ul>
                    </div>
                </main>
            </t>
        </t>
    </template>
</odoo>

