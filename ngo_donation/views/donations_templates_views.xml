            <!-- JavaScript to hide done_msg div on payment status page -->
            <script>
                (function() {
                    function hideDoneMessage() {
                        // Hide all elements containing the done message text
                        var allElements = document.querySelectorAll('*');
                        allElements.forEach(function(el) {
                            var text = el.textContent || el.innerText || '';
                            if (text.trim() &amp;&amp; (
                                text.includes('Your payment has been successfully processed') || 
                                text.includes('payment has been successfully processed') ||
                                text.includes('Ihre Zahlung wurde erfolgreich verarbeitet')
                            )) {
                                // Find the closest parent container (alert, notification, or div with background)
                                var container = el;
                                while (container &amp;&amp; container !== document.body) {
                                    var bgColor = window.getComputedStyle(container).backgroundColor;
                                    var classes = container.classList.toString();
                                    
                                    // Check if this is a container (alert, notification, or has green background)
                                    if (container.tagName === 'DIV' &amp;&amp; (
                                        classes.includes('alert') || 
                                        classes.includes('notification') ||
                                        classes.includes('o_notification') ||
                                        bgColor === 'rgb(212, 237, 218)' ||
                                        bgColor === 'rgb(209, 231, 221)' ||
                                        bgColor.includes('212, 237, 218') ||
                                        bgColor.includes('209, 231, 221')
                                    )) {
                                        container.style.display = 'none';
                                        container.style.visibility = 'hidden';
                                        container.style.height = '0';
                                        container.style.overflow = 'hidden';
                                        container.style.margin = '0';
                                        container.style.padding = '0';
                                        break;
                                    }
                                    container = container.parentElement;
                                }
                                
                                // Also hide the element itself
                                el.style.display = 'none';
                                el.style.visibility = 'hidden';
                            }
                        });
                    }
                    
                    // Run immediately and on DOM ready
                    hideDoneMessage();
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', hideDoneMessage);
                    }
                    
                    // Run multiple times to catch dynamically loaded content
                    setTimeout(hideDoneMessage, 50);
                    setTimeout(hideDoneMessage, 100);
                    setTimeout(hideDoneMessage, 300);
                    setTimeout(hideDoneMessage, 500);
                    setTimeout(hideDoneMessage, 1000);
                    setTimeout(hideDoneMessage, 2000);
                    
                    // Use MutationObserver to catch dynamically added content
                    var observer = new MutationObserver(function(mutations) {
                        hideDoneMessage();
                    });
                    observer.observe(document.body, {
                        childList: true,
                        subtree: true
                    });
                })();
            </script>

