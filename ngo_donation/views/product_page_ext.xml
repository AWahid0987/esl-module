        <!-- Inherit product template to translate product name and description -->
        <template id="product_translation" inherit_id="website_sale.product" name="Product Translation">
            <!-- Translate product name -->
            <xpath expr="//h1[@itemprop='name']" position="replace">
                <h1 itemprop="name">
                    <t t-esc="website.translate_product(product)['name']"/>
                </h1>
            </xpath>
            
            <!-- Add rating stars below product name (if not donation company) -->
            <xpath expr="//h1[@itemprop='name']" position="after">
                <t t-if="website.company_id.name != 'Global Development for Humanity'">
                    <div class="mt-2 d-flex align-items-center" itemprop="aggregateRating" itemscope="itemscope" itemtype="http://schema.org/AggregateRating">
                        <t t-set="rating_avg" t-value="float(product.rating_avg or 0)"/>
                        <t t-set="rating_count" t-value="int(product.rating_count or 0)"/>
                        <meta itemprop="ratingValue" t-att-content="rating_avg"/>
                        <meta itemprop="reviewCount" t-att-content="rating_count"/>
                        <meta itemprop="bestRating" content="5"/>
                        <!-- Star 1 -->
                        <i t-if="rating_avg &gt;= 1" class="fa fa-star text-warning" t-attf-title="Rating: {{rating_avg}}/5"/>
                        <i t-if="rating_avg &lt; 1" class="fa fa-star-o text-muted"/>
                        <!-- Star 2 -->
                        <i t-if="rating_avg &gt;= 2" class="fa fa-star text-warning"/>
                        <i t-if="rating_avg &lt; 2" class="fa fa-star-o text-muted"/>
                        <!-- Star 3 -->
                        <i t-if="rating_avg &gt;= 3" class="fa fa-star text-warning"/>
                        <i t-if="rating_avg &lt; 3" class="fa fa-star-o text-muted"/>
                        <!-- Star 4 -->
                        <i t-if="rating_avg &gt;= 4" class="fa fa-star text-warning"/>
                        <i t-if="rating_avg &lt; 4" class="fa fa-star-o text-muted"/>
                        <!-- Star 5 -->
                        <i t-if="rating_avg &gt;= 5" class="fa fa-star text-warning"/>
                        <i t-if="rating_avg &lt; 5" class="fa fa-star-o text-muted"/>
                        <small class="text-muted ms-1" t-if="rating_count &gt; 0">
                            (<t t-esc="rating_count"/>)
                        </small>
                    </div>
                </t>
            </xpath>

            <!-- Translate product description_ecommerce -->
            <xpath expr="//div[@id='product_details']/div[contains(@class, 'oe_structure')][1]" position="replace">
                <div t-out="website.translate_product(product)['description']" class="oe_structure"
                     placeholder="A detailed, formatted description to promote your product on this page. Use '/' to discover more features."/>
            </xpath>
        </template>

        <!-- Inherit products_item template to translate product name in listing -->
        <template id="products_item_translation" inherit_id="website_sale.products_item"
                  name="Products Item Translation">
            <!-- Translate product name in product listing -->
            <xpath expr="//h6[hasclass('o_wsale_products_item_title')]//a[@itemprop='name']" position="replace">
                <a class="text-primary text-decoration-none" itemprop="name" t-att-href="product_href"
                   t-esc="website.translate_product(product)['name']"/>
            </xpath>
        </template>

