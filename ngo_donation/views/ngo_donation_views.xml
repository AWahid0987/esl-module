<odoo>
    <record id="view_ngo_donation_list_id" model="ir.ui.view">
        <field name="name">ngo.donation.list</field>
        <field name="model">ngo.donation</field>

        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="donor_id" />
                <field name="project_id" />
                <field name="amount" />
                <field name="payment_status" />
            </list>
        </field>
    </record>
    <record id="view_ngo_donation_form" model="ir.ui.view">
        <field name="name">ngo.donation.form</field>
        <field name="model">ngo.donation</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="payment_status"
                        widget="statusbar" options="{'clickable': '1'}"
                    />
                </header>
                <sheet>
                    <group>

                        <group>
                            <field name="donor_id" />
                            <field name="project_id" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="amount" />

                            <field name="payment_reference" />
                            <field name="notes" />

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ngo_donation" model="ir.actions.act_window">
        <field name="name">Donations</field>
        <field name="res_model">ngo.donation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>