<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        <record id="email_donation_project_update" model="mail.template">
            <field name="name">Donation Project Update Email</field>
            <field name="model_id" ref="ngo_donation.model_donation_projects"/>
            <field name="subject">Update on Donation Project: {{object.name}}</field>
            <field name="email_from">{{user.email or 'noreply@example.com'}}</field>
            <field name="email_to">{{object._get_all_donor_emails()}}</field>
            <field name="body_html" type="html">
                <p>Dear Donor,</p>
                <p>We are excited to update you about the progress of the donation project <strong><t t-out="object.name" /></strong>.</p>
                <ul>
                    <li><strong>Target Amount:</strong> <t t-out="object.target_amount" /> <t t-out="object.currency_id.name" /></li>
                    <li><strong>Collected Amount:</strong> <t t-out="object.collected_amount" /> <t t-out="object.currency_id.name" /></li>
                    <li><strong>Spent Amount:</strong> <t t-out="object.spent_amount" /> <t t-out="object.currency_id.name" /></li>
                </ul>

                <p><strong>Purchases Made:</strong></p>
                <ul>
                    <t t-foreach="object.purchase_order_ids" t-as="po">
                        <li><strong><t t-esc="po.name"/></strong>: <t t-esc="po.partner_id.name"/> - <t t-esc="po.amount_total"/> <t t-esc="po.currency_id.name"/></li>
                    </t>
                </ul>
                <p>Thank you again for your generosity!</p>
            </field>
        </record>

    </data>

</odoo>