<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <template id="portal_ticket_new" name="Portal: New Ticket">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="False"/>
      <div class="container mt-4">
        <h2>Create a Ticket</h2>

        <form action="/my/tickets/create" method="post" enctype="multipart/form-data" class="mt-3">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

          <!-- Category = Helpdesk Team -->
          <div class="form-group mb-3">
            <label>Category (Team)</label>
            <select name="team_id" class="form-control" required="required">
              <option value="">-- Select --</option>
              <t t-foreach="teams" t-as="t">
                <option t-att-value="t.id"><t t-esc="t.name"/></option>
              </t>
            </select>
          </div>

          <div class="form-group mb-3">
            <label>Subject</label>
            <input type="text" name="subject" class="form-control" required="required"/>
          </div>

          <div class="form-group mb-3">
            <label>Add Attachments</label>
            <input type="file" name="attachments" class="form-control" multiple="multiple"/>
          </div>

          <div class="form-group mb-3">
            <label>Description</label>
            <textarea name="description" class="form-control" rows="5" required="required"></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Submit Ticket</button>
        </form>
      </div>
    </t>
  </template>
</odoo>

