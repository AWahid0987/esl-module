
<odoo>
    <record id="view_bale_form" model="ir.ui.view">
        <field name="name">product.bale.form</field>
        <field name="model">product.bale</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_sold" string="Mark as Sold" type="object" 
                            invisible="state == 'sold'"
                            class="oe_highlight"/>
                    <button name="action_mark_available" string="Mark as Available" type="object"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,sold"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_manufacturing" type="object" 
                                class="oe_stat_button" icon="fa-cogs"
                                invisible="not manufacturing_order_id">
                            <field name="manufacturing_order_id" widget="statinfo" string="Manufacturing Order"/>
                        </button>
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="not sale_order_line_id">
                            <field name="sale_order_line_id" widget="statinfo" string="Sale Order"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="barcode" widget="barcode"/>
                            <field name="product_id"/>
                            <field name="weight_kg"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="location_id"/>
                            <field name="lot_id"/>
                            <field name="manufacturing_order_id" readonly="1"/>
                            <field name="sale_order_line_id" readonly="1"/>
                        </group>
                    </group>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_bale_tree" model="ir.ui.view">
        <field name="name">product.bale.tree</field>
        <field name="model">product.bale</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="reference"/>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="weight_kg"/>
                <field name="quantity"/>
                <field name="location_id"/>
                <field name="state" widget="badge" decoration-success="state == 'available'" decoration-danger="state == 'sold'"/>
            </list>
        </field>
    </record>

    <record id="view_bale_search" model="ir.ui.view">
        <field name="name">product.bale.search</field>
        <field name="model">product.bale</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference"/>
                <field name="barcode"/>
                <field name="product_id"/>
                <field name="location_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                <separator/>
                <filter string="By Location" name="group_location" context="{'group_by': 'location_id'}"/>
                <filter string="By Product" name="group_product" context="{'group_by': 'product_id'}"/>
                <filter string="By State" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_bale" model="ir.actions.act_window">
        <field name="name">Bales</field>
        <field name="res_model">product.bale</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bale_search"/>
        <field name="context">{'search_default_available': 1}</field>
    </record>

    <record id="action_bale_inventory" model="ir.actions.act_window">
        <field name="name">Bales in Inventory</field>
        <field name="res_model">product.bale</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('location_id', '!=', False), ('state', '=', 'available')]</field>
        <field name="context">{'search_default_group_location': 1}</field>
    </record>

    <menuitem id="menu_bale_root" name="Bales"/>
    <menuitem id="menu_bale" parent="menu_bale_root" action="action_bale"/>
    <menuitem id="menu_bale_inventory" parent="menu_bale_root" action="action_bale_inventory"/>
</odoo>
