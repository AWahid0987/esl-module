<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_send_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.send.wizard.form</field>
        <field name="model">whatsapp.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="phone" required="1"/>
                    <field name="template_id"/>
                    <field name="body" widget="text" required="1"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
