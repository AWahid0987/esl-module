<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_gateway_session_list" model="ir.ui.view">
        <field name="name">whatsapp.gateway.session.list</field>
        <field name="model">whatsapp.gateway.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_gateway_session_form" model="ir.ui.view">
        <field name="name">whatsapp.gateway.session.form</field>
        <field name="model">whatsapp.gateway.session</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Device">
                <header>
                    <button name="action_fetch_qr" type="object" string="Fetch QR" class="btn-primary"/>
                    <button name="action_check_status" type="object" string="Check Status"/>
                    <field name="state" widget="statusbar" statusbar_visible="disconnected,connected"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="last_sync" readonly="1"/>
                        <field name="error" readonly="1"/>
                    </group>
                    <group>
                        <field name="qr_image" widget="image" readonly="1"/>
                        <field name="qr_payload" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_gateway_session" model="ir.actions.act_window">
        <field name="name">WhatsApp Device</field>
        <field name="res_model">whatsapp.gateway.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_whatsapp_gateway_session"
        name="Device"
        parent="menu_whatsapp_root"
        action="action_whatsapp_gateway_session"
        sequence="20"
    />
</odoo>
