<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="whatsapp_message_list" model="ir.ui.view">
        <field name="name">whatsapp.message.list</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="state"/>
                <field name="sent_at"/>
                <field name="model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="whatsapp_message_form" model="ir.ui.view">
        <field name="name">whatsapp.message.form</field>
        <field name="model">whatsapp.message</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Message">
                <header>
                    <button
                        name="action_send"
                        type="object"
                        string="Send"
                        class="btn-primary"
                        modifiers="{'invisible': [['state','not in',['draft','failed']]]}"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,failed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="provider"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="sent_at" readonly="1"/>
                        <field name="message_uid" readonly="1"/>
                        <field name="model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="body"/>
                        <field name="error" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_message" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_whatsapp_messages"
        name="Messages"
        parent="menu_whatsapp_root"
        action="action_whatsapp_message"
        sequence="10"
    />
</odoo>
