<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_whatsapp_wizard" type="object" string="WhatsApp" class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
