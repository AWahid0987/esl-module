<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_donation_project_transfer_wizard_form" model="ir.ui.view">
        <field name="name">donation.project.transfer.wizard.form</field>
        <field name="model">donation.project.transfer.wizard</field>
        <field name="arch" type="xml">
            <form string="Transfer Funds">
                <sheet>
                    <group>
                        <field name="donor_project_id" readonly="1"/>
                        <field name="recipient_project_id"/>
                        <field name="amount"/>
                        <field name="currency_id" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Transfer" type="object" name="action_transfer" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
