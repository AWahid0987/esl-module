<odoo>
    <template id="portal_my_home_1" inherit_id="portal.portal_my_home">

        <!-- Inheritance  of Alert Divs-->
        <xpath expr="//div[@id='portal_alert_category']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>

        <!-- Inheritance  of Donations  Divs-->
        <xpath expr="//div[@id='portal_client_category']" position="inside">

            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/ngo_donation/static/description/donation.svg'" />
                <t t-set="title">Donations</t>
                <t t-set="text">See your Donations</t>
                <t t-set="url" t-value="'/my/donation'"/>
                <t t-set="config_card" t-value="True" />
            </t>
        </xpath>

    </template>


