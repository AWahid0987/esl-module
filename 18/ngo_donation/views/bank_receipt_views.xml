<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_receipt_tree" model="ir.ui.view">
        <field name="name">bank.receipt.tree</field>
        <field name="model">bank.receipt</field>
        <field name="arch" type="xml">
            <list string="Bank Receipts">
                <field name="name"/>
                <field name="transaction_reference"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state == 'pending'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_bank_receipt_form" model="ir.ui.view">
        <field name="name">bank.receipt.form</field>
        <field name="model">bank.receipt</field>
        <field name="arch" type="xml">
            <form string="Bank Receipt">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" 
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" 
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="transaction_id" readonly="1"/>
                            <field name="transaction_reference"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="receipt_photo" widget="image" class="oe_avatar"/>
                            <field name="receipt_photo_filename" invisible="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="approved_by" readonly="1" invisible="state != 'approved'"/>
                            <field name="approved_date" readonly="1" invisible="state != 'approved'"/>
                            <field name="rejected_by" readonly="1" invisible="state != 'rejected'"/>
                            <field name="rejected_date" readonly="1" invisible="state != 'rejected'"/>
                            <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bank_receipt_search" model="ir.ui.view">
        <field name="name">bank.receipt.search</field>
        <field name="model">bank.receipt</field>
        <field name="arch" type="xml">
            <search string="Bank Receipts">
                <field name="name"/>
                <field name="transaction_reference"/>
                <field name="partner_id"/>
                <field name="transaction_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bank_receipt" model="ir.actions.act_window">
        <field name="name">Bank Receipts</field>
        <field name="res_model">bank.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bank_receipt_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>

